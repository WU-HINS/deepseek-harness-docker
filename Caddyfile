# Caddy reverse proxy for DeepSeek Harness.
#
# Listens on HTTPS port 8443 using Caddy's local/internal CA so the
# container works with IP addresses and hostnames alike (no public ACME).
# The CA root certificate is stored by Caddy at:
#   /data/caddy/pki/authorities/local/root.crt
#
# Env placeholders are substituted by Caddy at config load:
#   CADDY_ACCESS_HOST      - the HTTPS_ACCESS_HOST value (validated by entrypoint)
#   DSH_AUTH_SNIPPET       - which auth mode to import: auth_protected / auth_disabled
#   DSH_PROXY_SNIPPET      - which proxy mode to import: proxy_local / proxy_passthrough
#   DSH_UPSTREAM           - dsh listen address to proxy to (default 127.0.0.1:3080)
#   DSH_AUTH_USERNAME      - basic auth username
#   DSH_AUTH_PASSWORD_HASH - argon2id hash from 'caddy hash-password'
{
	admin off
	local_certs

	servers {
		# Only trust forwarding headers when the direct peer is a private
		# address. This lets a chained proxy on the LAN work (its
		# X-Forwarded-For / X-Real-IP are honoured) while ignoring headers
		# coming from the public internet.
		trusted_proxies static private_ranges

		# Resolve the client IP from these headers (subject to trusted_proxies
		# above) so {$...} placeholders that reference the client see the real
		# address even behind another hop.
		client_ip_headers X-Forwarded-For X-Real-IP
	}
}

# Basic auth on. Used when dsh does NOT ship its own auth
# (dsh < 0.1.5-rc.1).
(auth_protected) {
	basic_auth {
		{$DSH_AUTH_USERNAME} {$DSH_AUTH_PASSWORD_HASH}
	}
}

# Basic auth off. dsh >= 0.1.5-rc.1 authenticates itself via token; adding
# a second Basic Auth layer here only gets in the way.
(auth_disabled) {
}

# Default proxy mode: Caddy is the only ingress, so it may set the forwarding
# headers itself. This is Caddy's stock reverse_proxy behaviour:
#   Host              -> rewritten to the upstream address
#   X-Forwarded-For   -> Caddy's peer appended
#   X-Forwarded-Proto -> https
#   X-Real-IP         -> not set
(proxy_local) {
	reverse_proxy {$DSH_UPSTREAM:127.0.0.1:3080}
}

# Passthrough proxy mode: preserve the incoming Host only. All other headers
# keep Caddy's default behaviour (X-Forwarded-For still gets Caddy's peer
# appended, X-Real-IP is still not set).
(proxy_passthrough) {
	reverse_proxy {$DSH_UPSTREAM:127.0.0.1:3080} {
		header_up Host {http.request.host}
	}
}

https://{$CADDY_ACCESS_HOST}:8443 {
	import {$DSH_AUTH_SNIPPET:auth_protected}
	import {$DSH_PROXY_SNIPPET:proxy_local}
}
