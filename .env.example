# DeepSeek Harness - example environment
# Copy to .env and adjust values:  cp .env.example .env

# IPv4 address or hostname the UI is reached at.
# NO scheme, NO path, NO port.  e.g. 192.168.1.10  or  harness.example.com
HTTPS_ACCESS_HOST=192.168.1.10

# Basic-auth username. Allowed: letters, digits, dot, underscore, hyphen.
DSH_AUTH_USERNAME=admin

# Basic-auth password - at least 12 characters.
DSH_AUTH_PASSWORD=change-me-at-least-12-chars

# Host port mapped to container :8443 (optional, default 8443)
HTTPS_PORT=8443

# Container name (optional)
CONTAINER_NAME=deepseek-harness

# --- Recommended: preserve the incoming Host header (Caddy passthrough) ---
# When true, Caddy preserves the client-facing Host header instead of
# rewriting it to the loopback upstream. dsh then sees the real domain/SNI
# you used, so generated links and resources keep the correct host. Ideal
# when the UI is reached through a reverse proxy, a domain, or a LAN gateway.
# true is the default (recommended); set false for Caddy's proxy_local mode.
DSH_PRESERVE_HOST=true

# --- Optional: dsh listen address (advanced) ---
# Loopback by default (Caddy is the single ingress). Change only if you
# know what you are doing - publishing dsh directly bypasses Caddy TLS+auth.
# DSH_HOST=127.0.0.1
# DSH_PORT=3080
# DSH_TRUSTED_HOST=127.0.0.1:3080

# Optional resource limits
# CPUS=2
# MEMORY_LIMIT=2g
